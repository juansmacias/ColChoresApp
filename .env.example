# ============================================================
# Family Chores App — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# Flutter does not read .env files at runtime automatically.
# These values are passed at build/run time via --dart-define-from-file:
#   flutter run --dart-define-from-file=.env
#   flutter build apk --dart-define-from-file=.env
#
# Access in code via: const String.fromEnvironment('KEY')
# ============================================================

# ------------------------------------------------------------
# App Environment
# ------------------------------------------------------------
# Options: development | staging | production
ENV=development

# App version label shown in debug info (matches pubspec.yaml version)
APP_VERSION=1.0.0

# ------------------------------------------------------------
# Firebase — Project Config
# ------------------------------------------------------------
# These are generated by `flutterfire configure` into firebase_options.dart.
# You do NOT need to set them here manually — flutterfire handles it.
# Listed here for reference only.
#
# FIREBASE_PROJECT_ID=colchoresapp
# FIREBASE_ANDROID_APP_ID=1:xxx:android:xxx
# FIREBASE_IOS_APP_ID=1:xxx:ios:xxx
# FIREBASE_WEB_APP_ID=1:xxx:web:xxx
# FIREBASE_API_KEY=your-web-api-key
# FIREBASE_MESSAGING_SENDER_ID=xxxxxxxxxx
# FIREBASE_STORAGE_BUCKET=colchoresapp.appspot.com

# ------------------------------------------------------------
# Firebase Emulators (local development only)
# ------------------------------------------------------------
# Set USE_FIREBASE_EMULATOR=true to point the app at local emulators.
# Ignored in production builds.
USE_FIREBASE_EMULATOR=true

# Emulator host:
#   Android emulator  → 10.0.2.2
#   iOS simulator     → localhost
#   Physical device   → your machine's local IP (e.g. 192.168.1.x)
EMULATOR_HOST=localhost

FIRESTORE_EMULATOR_PORT=8080
AUTH_EMULATOR_PORT=9099
FUNCTIONS_EMULATOR_PORT=5001

# ------------------------------------------------------------
# PIN & Security
# ------------------------------------------------------------
# Salt prefix used when hashing PINs with SHA-256.
# Change this value per environment. Never share the production value.
PIN_SALT=change-me-before-production

# Number of failed PIN attempts before lockout
PIN_MAX_ATTEMPTS=5

# Lockout duration in seconds (default: 300 = 5 minutes)
PIN_LOCKOUT_SECONDS=300

# ------------------------------------------------------------
# Feature Flags
# ------------------------------------------------------------
# Enable or disable features per environment (true | false)
FEATURE_BIOMETRIC_PIN=true
FEATURE_FAIRNESS_DASHBOARD=true
FEATURE_EMMA_VIEW=true
FEATURE_PUSH_NOTIFICATIONS=true

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
# Log level: none | error | warning | info | debug | verbose
LOG_LEVEL=debug

# ------------------------------------------------------------
# Fastlane / Store Delivery
# ------------------------------------------------------------
# Fastlane reads these from your shell environment when running
# screenshot or deployment lanes.
#
# Android:
#   SUPPLY_JSON_KEY=/absolute/path/to/google-play-service-account.json
#   FASTLANE_ANDROID_TRACK=internal
#   FASTLANE_ANDROID_PACKAGE_NAME=com.juansmacias.familychores.family_chores_app
#
# iOS:
#   FASTLANE_APP_IDENTIFIER=com.juansmacias.familychores.familyChoresApp
#   FASTLANE_APPLE_ID=you@example.com
#   FASTLANE_TEAM_ID=YOURTEAMID
#   FASTLANE_ITC_TEAM_ID=123456789
#   APP_STORE_CONNECT_KEY_ID=ABC123XYZ
#   APP_STORE_CONNECT_ISSUER_ID=00000000-0000-0000-0000-000000000000
#   APP_STORE_CONNECT_KEY_FILE=/absolute/path/to/AuthKey_ABC123XYZ.p8
#
# Shared:
#   FASTLANE_SCREENSHOT_DELAY=5
